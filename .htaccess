RewriteEngine On

# Explicit checkout routes
RewriteRule ^checkout/?$ checkout.php [L,QSA]
RewriteRule ^create-stripe-checkout/?$ create-stripe-checkout.php [L,QSA]

# Redirect /page.php to /page
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[\s?]) [NC]
RewriteRule ^(.+?)\.php$ /$1 [R=301,L,NE]

# Internally load /page as /page.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]