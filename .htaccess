RewriteEngine On

# ==========================================================
# Explicit routes
# ==========================================================

RewriteRule ^checkout/?$ checkout.php [L,QSA]
RewriteRule ^create-stripe-checkout/?$ create-stripe-checkout.php [L,QSA]


# ==========================================================
# NEVER redirect API endpoints
# ==========================================================

RewriteCond %{REQUEST_URI} /api/ [NC]
RewriteRule ^ - [L]


# ==========================================================
# Redirect normal PAGE.php -> PAGE
# GET / HEAD only
# ==========================================================

RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[\s?]) [NC]
RewriteRule ^(.+?)\.php$ /$1 [R=301,L,NE]


# ==========================================================
# Internally resolve clean page URLs
# ==========================================================

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]